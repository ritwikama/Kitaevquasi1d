   RowBox[{"(*", 
    RowBox[{"We", " ", "use", " ", 
     RowBox[{"Log", "[", 
      RowBox[{"detM", "[", "k", "]"}], "]"}], " ", "to", " ", "represent", 
     " ", "the", " ", "logarithm"}], "*)"}], "\[IndentingNewLine]", 
