   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"detM", "[", "k_", "]"}], ":=", 
     RowBox[{"Det", "[", 
      RowBox[{"M", "[", "k", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "the", " ", 
     RowBox[{"integrand", ":", 
      RowBox[{
       RowBox[{"d", "/", "dk"}], " ", "ln", 
       RowBox[{"(", 
        RowBox[{"det", 
         RowBox[{"(", 
          RowBox[{"M", 
